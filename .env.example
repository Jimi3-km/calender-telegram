# ─────────────────────────────────────────────────────────────
#  Google Calendar Configuration
# ─────────────────────────────────────────────────────────────

# The ID of the Google Calendar to read events from.
# Found in Calendar Settings → "Integrate calendar" → Calendar ID.
# Looks like: your-name@group.calendar.google.com  or  your-email@gmail.com
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Absolute or relative path to your Google Service Account JSON key file.
# Create a Service Account in GCP, download the key, ENABLE the Google Calendar API
# for your project, and share your target calendar with the Service Account's email
# address (Viewer permission is enough).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# ─────────────────────────────────────────────────────────────
#  Telegram Configuration
# ─────────────────────────────────────────────────────────────

# Your Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHijklMNOpqrsTUVwxyz

# The Telegram Chat ID to send messages to.
# For groups: a negative number like -1001234567890
# For channels: use @channelname  or the numeric chat ID
# For a private DM to yourself: your user ID (a positive number)
TELEGRAM_CHAT_ID=-1001234567890

# ─────────────────────────────────────────────────────────────
#  Scheduler & Notification Window Configuration
# ─────────────────────────────────────────────────────────────

# How often to poll Google Calendar (standard cron expression).
# Default: every 15 minutes.
CRON_SCHEDULE=*/15 * * * *

# How far ahead (in minutes) to look for upcoming events.
# Events starting within this window will be notified.
# Default: 60 minutes.
LOOKAHEAD_MINUTES=60

# ─────────────────────────────────────────────────────────────
#  Application
# ─────────────────────────────────────────────────────────────

# Path to the JSON file used to track which events have been notified.
# Relative paths are resolved from the project root.
# Default: ./data/store.json
STORE_PATH=./data/store.json

# Timezone for displaying event times in Telegram messages.
# Standard IANA timezone name.  Default: UTC
TIMEZONE=UTC

# Minimum log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info
