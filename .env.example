# Google Calendar
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# Path to the service account JSON key file (see README for setup)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
# Group and channel IDs are negative numbers; user IDs are positive
TELEGRAM_CHAT_ID=your-chat-id

# Scheduler
CRON_SCHEDULE=*/15 * * * *
LOOKAHEAD_MINUTES=60

# Application
STORE_PATH=./data/store.json
# IANA timezone used when formatting notification times (e.g. Africa/Nairobi)
TIMEZONE=UTC
LOG_LEVEL=info
